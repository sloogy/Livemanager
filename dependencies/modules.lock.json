{
  "schema": "lifeplanner.module-sources.v1",
  "host_version": "0.6.4",
  "modules": [
    {
      "id": "budgetmanager",
      "name": "BudgetManager",
      "version": "3.0.9",
      "default_repository": "sloogy/Budgetmanager",
      "repository_variable": "BUDGETMANAGER_REPOSITORY",
      "default_ref": "v3.0.9",
      "ref_variable": "BUDGETMANAGER_REF",
      "source_environment": "LIFEPLANNER_BUDGETMANAGER_SOURCE",
      "default_sibling": "../Budgetmanager",
      "build_spec": "BudgetManager.spec",
      "dist_directory": "dist/BudgetManager",
      "runtime_directory": "BudgetManager",
      "description": "Budget, Buchungen, Forecasts, Sparziele und Monatsabschluss.",
      "eigener_updater": true
    },
    {
      "id": "fpm",
      "name": "FPM - Fountain Pen Manager",
      "version": "1.4.3",
      "default_repository": "sloogy/FPM",
      "repository_variable": "FPM_REPOSITORY",
      "default_ref": "v1.4.3",
      "ref_variable": "FPM_REF",
      "source_environment": "LIFEPLANNER_FPM_SOURCE",
      "default_sibling": "../FPM",
      "build_spec": "FPM.spec",
      "dist_directory": "dist/FountainPenManager",
      "runtime_directory": "FountainPenManager",
      "description": "Füller, Tinten, Federn, Papier, Rotation und Sammlungswissen.",
      "eigener_updater": true
    },
    {
      "id": "freizeitmanager",
      "name": "FreizeitManager",
      "version": "0.2.4",
      "description": "Freundschaftspflege, Kontaktrotation, Aktivitaeten und Freizeitplanung.",
      "default_repository": "sloogy/Kontaktmanager",
      "repository_variable": "FREIZEITMANAGER_REPOSITORY",
      "default_ref": "v0.2.4",
      "ref_variable": "FREIZEITMANAGER_REF",
      "source_environment": "LIFEPLANNER_FREIZEITMANAGER_SOURCE",
      "default_sibling": "../Kontaktmanager",
      "build_spec": "FreizeitManager.spec",
      "dist_directory": "dist/FreizeitManager",
      "runtime_directory": "FreizeitManager",
      "eigener_updater": false
    }
  ]
}
